---
import type { ImageMetadata } from "astro";
import type { ModelName } from "./react/scene/models";
import Slot3D from "./Slot3D.astro";

interface Props {
	name: string;
	blurb: string;
	href: string | null;
	tone: "orange" | "blue" | "yellow" | "white";
	model: ModelName;
	badge?: string;
	fallback: ImageMetadata;
}

const { name, blurb, href, tone, model, badge, fallback } = Astro.props;

const toneClass = {
	orange: "bg-orange",
	blue: "bg-blue text-white",
	yellow: "bg-yellow",
	white: "border-[1.5px] border-ink bg-white",
}[tone];
const note = badge ?? (href ? null : "link soon");
const Tag = href ? "a" : "div";
---

<Tag
	href={href ?? undefined}
	class:list={[
		"flex min-h-[200px] flex-col justify-between gap-10 rounded-[20px] p-5",
		toneClass,
		href && tone === "blue" && "hover:text-white hover:opacity-90",
		href && tone !== "blue" && "hover:text-ink hover:opacity-90",
	]}
>
	<span class="flex flex-col gap-4">
		<Slot3D
			model={model}
			fallback={fallback}
			alt=""
			class="relative h-[72px] w-[72px] overflow-hidden rounded-[20px] border-2 border-dashed border-ink bg-white/70"
		/>
		<span class="max-w-[280px]">{blurb}</span>
	</span>
	<span class="flex items-center justify-between gap-3">
		<span
			class:list={[
				"rounded-full px-[18px] py-2.5",
				tone === "white" ? "bg-ink text-white" : "bg-white text-ink",
			]}>{name}</span
		>
		{
			href && (
				<span
					class:list={[
						"flex h-10 w-10 items-center justify-center rounded-full",
						tone === "white"
							? "border-[1.5px] border-ink text-ink"
							: "bg-white text-ink",
					]}
				>
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"
					>
						<path d="M7 17L17 7M9 7h8v8" />
					</svg>
				</span>
			)
		}
		{
			note && (
				<span class="-rotate-6 font-marker text-lg text-ink">{note}</span>
			)
		}
	</span>
</Tag>
