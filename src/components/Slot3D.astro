---
import { Picture } from "astro:assets";

interface Props {
	model: string;
	fallback: ImageMetadata;
	alt: string;
	class?: string;
}

const { model, fallback, alt, class: className } = Astro.props;
---

<div data-3d-slot={model} class:list={[className]}>
	<Picture
		src={fallback}
		alt={alt}
		formats={["avif", "webp"]}
		widths={[400, 800]}
		sizes="180px"
		data-3d-fallback
		class="absolute inset-0 h-full w-full object-cover"
	/>
</div>
