---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Doodle from "../components/Doodle.astro";
import Marquee from "../components/Marquee.astro";
import ProjectBrowser from "../components/react/ProjectBrowser";
import Slot3D from "../components/Slot3D.astro";
import { CONTACT } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toProjectView } from "../lib/images";
import { pickFeatured, sortProjects, TINT_BG } from "../lib/projects";

const entries = await getCollection("projects");
const featured = pickFeatured(
	entries.map((entry) => ({ ...entry.data, slug: entry.id })),
);
const projects = await Promise.all(
	sortProjects(
		entries.map((entry) => ({
			order: entry.data.order,
			title: entry.data.title,
			entry,
		})),
	).map(({ entry }) => toProjectView(entry)),
);
---

<BaseLayout
	title="Portfolio"
	description="Web apps, production tools, and the electric vehicles Ahmad ‘Afien Zidan helped build."
	current="portfolio"
>
	<section
		class="relative mx-auto flex max-w-[1280px] flex-wrap items-end justify-between gap-6 px-6 pt-14 pb-10"
	>
		<div class="flex flex-col gap-3">
			<p class="font-marker text-2xl">Stuff I’ve built</p>
			<h1
				class="-rotate-2 font-display text-[clamp(64px,9vw,128px)] leading-[0.9] font-normal text-orange [-webkit-text-stroke:4px_#111111] [paint-order:stroke_fill] [text-shadow:6px_6px_0_#111111]"
			>
				MY WORK
			</h1>
		</div>
		<Doodle
			kind="star"
			class="absolute top-10 left-[min(560px,70%)] h-[72px] w-[72px]"
		/>
		<p class="max-w-[400px] text-muted">
			Web apps, production tools, and the electric vehicles I helped build
			before I moved into software.
		</p>
	</section>

	{
		featured && (
			<section
				aria-label="Featured project"
				class="mx-auto max-w-[1280px] px-6 pb-14"
			>
				<a
					href={featured.liveUrl}
					class="flex flex-wrap items-stretch overflow-hidden rounded-3xl border border-line bg-white hover:text-ink"
				>
					<div
						class:list={[
							"flex min-h-60 flex-[1_1_240px] flex-col justify-between gap-6 p-7",
							TINT_BG[featured.tint],
						]}
					>
						<p class="text-[15px] leading-[1.4] tracking-[0.08em] uppercase">
							Featured
							<br />
							project
							<br />
							// {featured.year}
						</p>
						<Slot3D
							model="featured"
							fallback={featured.cover}
							alt=""
							class="relative h-32 w-32 overflow-hidden rounded-[28px] border-2 border-dashed border-ink bg-white/60"
						/>
					</div>
					<Picture
						src={featured.gallery[0] ?? featured.cover}
						alt={`${featured.title} screenshot`}
						formats={["avif", "webp"]}
						widths={[400, 800, 1200, 1600]}
						sizes="(min-width: 1280px) 320px, 100vw"
						class="h-full min-h-60 w-full bg-sand object-cover"
						pictureAttributes={{ class: "block min-h-60 flex-[1_1_280px]" }}
					/>
					<div
						class="flex min-w-0 flex-[999_1_420px] flex-wrap items-center justify-between gap-6 p-8"
					>
						<div class="flex flex-col gap-3">
							<h2
								class="-rotate-3 font-display text-[clamp(40px,4.5vw,64px)] leading-[0.95] font-normal text-blue uppercase [-webkit-text-stroke:3px_#111111] [paint-order:stroke_fill] [text-shadow:4px_4px_0_#111111]"
							>
								{featured.title}
							</h2>
							<p class="max-w-[380px]">{featured.summary}</p>
							<p class="text-[15px] text-muted">
								{featured.stack.join(" · ")}
							</p>
						</div>
						<span class="flex flex-col items-start gap-3">
							<span
								class="flex h-[52px] w-[52px] items-center justify-center rounded-full border-[1.5px] border-ink"
							>
								<svg
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg
								>
							</span>
							<span>Open the<br />live app</span>
						</span>
					</div>
				</a>
			</section>
		)
	}

	<Marquee
		tone="accent"
		tilt={1.2}
		items={[
			"SHIPPED & LIVE",
			"BUILT WITH CARE",
			"WEB · TOOLS · EVs",
			"MORE COMING SOON",
		]}
	/>

	<section aria-labelledby="all-work" class="border-t border-line">
		<div
			class="mx-auto flex max-w-[1280px] flex-wrap gap-10 px-6 pt-14 pb-[72px]"
		>
			<div class="flex min-w-0 flex-[999_1_640px] flex-col">
				<ProjectBrowser client:load projects={projects} />
			</div>
			<aside
				class="flex flex-[1_1_260px] flex-col justify-center gap-5 border-line min-[960px]:border-l min-[960px]:pl-8"
			>
				<p class="-rotate-6 font-marker text-5xl leading-[0.95]">
					Got an<br />idea?<br />Let’s build :)
				</p>
				<Doodle kind="smiley" class="h-14 w-14 -rotate-10" />
				<p class="text-muted">
					Want to build something together? My inbox is open.
				</p>
				<a
					href={`mailto:${CONTACT.email}`}
					class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-[10px] bg-ink px-6 text-white hover:text-white hover:opacity-85"
				>
					Say hello
					<svg
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
					>
				</a>
			</aside>
		</div>
	</section>
</BaseLayout>
